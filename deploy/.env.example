# Copy to /home/ubuntu/stacks/essentia/deploy/.env on the VM and fill in.
# Never commit the real file.
MONGODB_URI=
MONGODB_DB=essentia
# Which catalogues are switched on, in order (corpus/sources/__init__.py).
#   deezer   30-second previews. DEVELOPMENT ONLY -- Deezer's terms do not
#            let us ship it in a product, which is why `jamendo` exists.
#   jamendo  Creative Commons music, full audio, shippable. Needs the client
#            id below; every track carries a backlink the clients must show.
# Production is SOURCES=jamendo, with `deezer` removed. Both may be listed
# in development (`SOURCES=deezer,jamendo`); the crawler round-robins them.
SOURCES=deezer
# Free, from https://developer.jamendo.com. Without it the jamendo source
# disables itself with a log line -- unless it is the only one configured,
# where it refuses to start rather than pretend. The free quota is per
# MONTH (35k requests), so a long crawl is the thing that exhausts it.
JAMENDO_CLIENT_ID=
PUBLIC_BASE_URL=https://essentia.gabeyocum.com/api
# Stop crawling when the Atlas database (data + indexes) reaches this many
# bytes. 450 MB of the free 512 MB cluster; the rest stays free for other data.
CORPUS_BYTES_CAP=471859200
# Backstop track count; the byte cap normally wins.
CORPUS_CAP=300000
# The insights endpoints compute over at most this many tracks nearest the
# seed (dense n×n similarity: 8000 rows = 256 MB float32).
VIZ_MAX=8000
# The insights endpoints project a snapshot of the corpus matrix rather than
# the live one, so the picture is stable and a request never pays for a
# rebuild. The snapshot refreshes at most once per this many seconds (or
# sooner once the corpus has grown by VIZ_GROWTH_PCT). The cost is that it
# pins the superseded matrix in memory for the whole window: lower this to
# 120 on a very large corpus to hold that copy for less time; raise it to
# spend less CPU on recomputation.
VIZ_REFRESH_S=300
CRAWL_INTERVAL_S=60
# The insights snapshot also refreshes early once the corpus has grown by
# this percentage since it was taken.
VIZ_GROWTH_PCT=5
# How many embed jobs the worker claims (and analyzes) at once, and the size
# of one re-analysis group. CLAP embeds the whole group in a single forward
# pass, so a group amortizes the fixed cost of that; it is also the download
# fan-out. Drop to 2 if a group's peak memory is uncomfortable on this box.
GROUP_SIZE=3
# Parallel preview downloads inside a group. Keep at or below GROUP_SIZE --
# more threads just means more simultaneous requests to the same CDN.
DOWNLOAD_THREADS=3

# The feel blend (README, "The feel slider") needs NOTHING here: the axes are
# prompts scored against the CLAP weights baked into the image by
# deploy/Dockerfile's scripts/fetch_models.py step, and the blend weight is a
# per-request query parameter whose default is the server's own FEEL_DEFAULT.

# RE-ANALYSIS also needs nothing here. When FEATURES_VERSION goes up, every
# stored row is below it and therefore invisible to the ranking; the worker
# re-downloads and re-analyzes GROUP_SIZE of them per tick, oldest first,
# before it crawls, and logs "reanalyzed N, remaining M". The corpus refills
# over that window. A row whose audio can no longer be fetched or decoded is
# marked on the track document and skipped rather than retried forever.

# GET /search/text needs NOTHING here either, but it has a cost worth
# knowing before it is switched on: the first text search LOADS CLAP INTO
# THE API PROCESS -- ~700 MB of weights and roughly 2.5 GB resident once
# torch's allocator is warm. The import is lazy, so an API container that
# never serves a text search never pays it; a container that does needs a
# mem_limit sized for the API *and* that copy, on a box already running the
# embed worker's own copy. If the two cannot both fit, run the API with the
# text search unused (it answers 503 without CLAP) rather than swapping.
