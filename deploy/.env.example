# Copy to /home/ubuntu/stacks/essentia/deploy/.env on the VM and fill in.
# Never commit the real file.
MONGODB_URI=
MONGODB_DB=essentia
PUBLIC_BASE_URL=https://essentia.gabeyocum.com/api
# The API keeps a float32 corpus matrix plus a float64 unit-normalized copy
# in RAM. At 25k tracks x 1280 dims that's ~380 MB, which fits the 4 GB
# container alongside TensorFlow. Raise this only if you also raise the
# container's memory limit.
CORPUS_CAP=25000
CRAWL_INTERVAL_S=60
