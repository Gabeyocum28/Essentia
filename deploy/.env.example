# Copy to /home/ubuntu/stacks/essentia/deploy/.env on the VM and fill in.
# Never commit the real file.
MONGODB_URI=
MONGODB_DB=essentia
PUBLIC_BASE_URL=https://essentia.gabeyocum.com/api
# Stop crawling when the Atlas database (data + indexes) reaches this many
# bytes. 450 MB of the free 512 MB cluster; the rest stays free for other data.
CORPUS_BYTES_CAP=471859200
# Backstop track count; the byte cap normally wins.
CORPUS_CAP=300000
# The insights endpoints compute over at most this many tracks nearest the
# seed (dense n×n similarity: 8000 rows = 256 MB float32).
VIZ_MAX=8000
CRAWL_INTERVAL_S=60
