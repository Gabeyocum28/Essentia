<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>BestRec</string>
	<!-- Allow cleartext HTTP to localhost/local domains so the app can reach the
	     dev mock server at http://localhost:8000 from the simulator. The team
	     server is reached over HTTPS at essentia.gabeyocum.com, so no ATS
	     exception for it is needed. Does not permit arbitrary insecure loads
	     to the public internet. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
